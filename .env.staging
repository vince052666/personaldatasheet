APP_NAME="PDS Management System - Staging"
APP_ENV=staging
APP_KEY=CHANGE_ME_GENERATE_WITH_php_artisan_key:generate
APP_DEBUG=true
APP_TIMEZONE=Asia/Manila
APP_URL=https://staging.your-domain.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

LOG_CHANNEL=stack
LOG_STACK=single,daily
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=pds_staging
DB_USERNAME=pds_user
DB_PASSWORD=CHANGE_ME_USE_STRONG_PASSWORD

SESSION_DRIVER=redis
SESSION_LIFETIME=120

CACHE_STORE=redis
QUEUE_CONNECTION=redis

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Staging-specific settings
BACKUP_RETENTION_DAYS=7
DATA_RETENTION_YEARS=1
